      "source": [
        "import csv\n",
        "\n",
        "with open('trainingdata.csv', 'w', newline='') as file:\n",
        "    writer = csv.writer(file)\n",
        "    writer.writerow(['Sky', 'AirTemp', 'Humidity', 'Wind', 'Water', 'Forecast', 'EnjoySport'])\n",
        "    writer.writerows([\n",
        "        ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "        ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "        ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "        ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']\n",
        "    ])\n",
        "\n",
        "def is_consistent(h, x):\n",
        "    for i in range(len(h)):\n",
        "        if h[i] != '?' and h[i] != x[i]:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "\n",
        "def more_general(h1, h2):\n",
        "    for i in range(len(h1)):\n",
        "        if h1[i] != '?' and h1[i] != h2[i]:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "\n",
        "def candidate_elimination(filename):\n",
        "\n",
        "    with open(filename, 'r') as file:\n",
        "        data = list(csv.reader(file))\n",
        "\n",
        "    attributes = data[0][:-1]\n",
        "    examples = data[1:]\n",
        "\n",
        "    n = len(attributes)\n",
        "\n",
        "    S = ['0'] * n\n",
        "    G = [['?'] * n]\n",
        "\n",
        "    for example in examples:\n",
        "\n",
        "        x = example[:-1]\n",
        "        label = example[-1]\n",
        "\n",
        "        if label == 'Yes':\n",
        "\n",
        "\n",
        "            G = [g for g in G if is_consistent(g, x)]\n",
        "\n",
        "            # Generalize S\n",
        "            for i in range(n):\n",
        "                if S[i] == '0':\n",
        "                    S[i] = x[i]\n",
        "                elif S[i] != x[i]:\n",
        "                    S[i] = '?'\n",
        "\n",
        "        elif label == 'No':\n",
        "\n",
        "            new_G = []\n",
        "\n",
        "            for g in G:\n",
        "\n",
        "                if is_consistent(g, x):\n",
        "\n",
        "                    for i in range(n):\n",
        "\n",
        "                        if g[i] == '?':\n",
        "                            if S[i] != x[i]:\n",
        "                                h = g.copy()\n",
        "                                h[i] = S[i]\n",
        "                                new_G.append(h)\n",
        "                else:\n",
        "                    new_G.append(g)\n",
        "\n",
        "            G = new_G\n",
        "\n",
        "\n",
        "    G = [g for g in G if more_general(g, S)]\n",
        "\n",
        "    print(\"\\nAttributes:\")\n",
        "    print(attributes)\n",
        "\n",
        "    print(\"\\nSpecific Boundary (S):\")\n",
        "    print(S)\n",
        "\n",
        "    print(\"\\nGeneral Boundary (G):\")\n",
        "    for g in G:\n",
        "        print(g)\n",
        "\n",
        "\n",
        "candidate_elimination(\"trainingdata.csv\")"
      ],
